{
  "manifest_version": 3,
  "name": "X Video Downloader",
  "version": "1.0.0",
  "description": "Download videos and GIFs from X / Twitter. Pick the quality, choose a folder, and keep a full download history.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "X Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://mobile.x.com/*",
    "*://pro.x.com/*",
    "*://cdn.syndication.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://mobile.x.com/*",
        "*://pro.x.com/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected.js"],
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://mobile.x.com/*",
        "*://pro.x.com/*"
      ]
    }
  ]
}
