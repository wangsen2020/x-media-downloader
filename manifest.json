{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.6.0",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "optional_permissions": [
    "identity"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://mobile.x.com/*",
    "*://pro.x.com/*",
    "*://cdn.syndication.twimg.com/*"
  ],
  "optional_host_permissions": [
    "https://www.googleapis.com/*",
    "https://video.twimg.com/*",
    "https://pbs.twimg.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://mobile.x.com/*",
        "*://pro.x.com/*"
      ],
      "js": [
        "src/injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://mobile.x.com/*",
        "*://pro.x.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected.js",
        "src/content-batch.js",
        "src/lib/batch.js",
        "src/lib/media.js",
        "src/lib/i18n.js"
      ],
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://mobile.x.com/*",
        "*://pro.x.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
